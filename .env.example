# ============================================================================
# ZOLO Chat - Server & Production Environment Variables (.env.example)
# Copy to .env for local development. Never commit real credentials to Git.
# ============================================================================

# Server Runtime
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
CORS_ORIGIN=""

# Cryptographic HMAC Secret for Session & Recovery Key Hashing (generate 32+ random bytes)
AUTH_SECRET="CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_SECRET"

# Supabase Database & Storage Configuration
SUPABASE_URL="https://beqkcbugflzopzvzhkua.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJlcWtjYnVnZmx6b3B6dnpoa3VhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMxNzcxMzksImV4cCI6MjEwODc1MzEzOX0.hdKJpsnoYnw2622-Mam8qocJTzSL3vLr0TONLafq7s8"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJlcWtjYnVnZmx6b3B6dnpoa3VhIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MzE3NzEzOSwiZXhwIjoyMTA4NzUzMTM5fQ.LPKrx8kZzdohVR9IRpAIVXhgHLxrEJOTmv3Ea66ENcE"

# PostgreSQL Database (Object Method Configuration)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="zolo_chat"
SQL_USER="zolo_app_user"
SQL_PASSWORD="YOUR_SQL_APP_PASSWORD"
SQL_ADMIN_USER="zolo_admin_user"
SQL_ADMIN_PASSWORD="YOUR_SQL_ADMIN_PASSWORD"

# Optional S3-Compatible Persistent Object Storage (AWS S3 / Cloudflare R2 / Tigris)
S3_BUCKET="YOUR_BUCKET_NAME"
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID="YOUR_S3_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="YOUR_S3_SECRET_ACCESS_KEY"
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="false"

# WebRTC STUN/TURN Configuration (Optional - defaults to Google STUN if unset)
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478"
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Gemini API Key (Injected automatically in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
